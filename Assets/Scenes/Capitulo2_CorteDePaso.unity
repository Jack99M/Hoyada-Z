  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Companera
  nombre: Tito
  estado: 1
  escondite: {x: -71, y: 0, z: 174.2}
  destinoSeparacion: {x: 1.4, y: 0, z: -3.6}
  intervaloAyuda: 6
  avisos:
  - "\xA1Wara, atr\xE1s tuyo!"
  - "\xA1Cuidado, cebrita, por detr\xE1s!"
  - "\xA1Ah\xED viene uno por tu espalda!"
  - "\xA1Wara, date la vuelta!"
  tiros:
  - "\xA1Toma, llave inglesa en la cabeza!"
  - "\xA1Su\xE9ltala, desgraciado!"
  - "\xA1Eso es por mis compa\xF1eros!"
  - "\xA1Ya est\xE1, ya est\xE1!"
  consejosJefe:
  - "\xA1Ag\xE1chate, Wara! \xA1Si te ve parada, dispara!"
  - "\xA1De frente no le hace nada, tiene casco y chaleco!"
  - "\xA1Yo le hago bulla, t\xFA rod\xE9alo por atr\xE1s!"
  - "\xA1Cuando recarga es tu momento!"
  - "\xA1T\xEDrale una botella lejos con la Q, que se voltee!"
  distracciones:
  - "\xA1Oye, Paco! \xA1Aqu\xED estoy, pues!"
  - "\xA1Por aqu\xED, mi subteniente!"
  - "\xA1Ac\xE1, ac\xE1! \xA1Disp\xE1rame a m\xED!"
  - "\xA1Eh, Mamani! \xA1M\xEDrame!"
  cuerpoACuerpo: 1
  danoCuerpoACuerpo: 18
  distraeJefe: 1
