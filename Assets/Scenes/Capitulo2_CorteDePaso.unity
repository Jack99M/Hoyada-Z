  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Juego
  jugador: {fileID: 1740463443}
  camara: {fileID: 1901802394}
  sol: {fileID: 1648186129}
  supervivencia: {fileID: 0}
  tituloCapitulo: "Cap\xEDtulo 2: Corte de Paso"
  capitulo: 2
  nombreJugador: Wara
  nombreCompleto: WARA CONDORI
  escenaSiguiente: 
  lemaMenu: "El Alto, Bolivia. La tarde en que la fiebre subi\xF3 a la Ceja."
  tarjetasIntro:
  - El Alto, Bolivia
  - "La Ceja. S\xE1bado, 16:20."
  - "Desde el amanecer, la fiebre del Choqueyapu subi\xF3 por las laderas.\nA media
    tarde, la Feria 16 de Julio ya no era una feria."
  - "Wara Condori subi\xF3 sola a El Alto para buscar a su mam\xE1 en Villa Dolores.\nEn
    la feria, un t\xE9cnico de celulares la sac\xF3 de entre la turba: Tito Huanca."
  alEmpezar:
    objetivo: "Sal del callej\xF3n antes de que rompan la reja"
    usarMarcador: 1
    marcador: {x: 0, y: 0, z: 31}
    subtitulos: []
    mensaje: "Juegas como Wara  \xB7  [2] honda: silenciosa, aturde  \xB7  [Shift]
      correr  \xB7  [E] interactuar"
    activar: []
    desactivar: []
    alertar: []
    despertar: []
    puntoControl: 0
    sonido: 
    moral: 0
    progresoCielo: -1
    abrirPuerta: {fileID: 0}
    trabarPuertas: []
    destrabarPuertas: []
    iniciarAsedio: {fileID: 0}
    iniciarFinal: 0
    cinematica: {fileID: 0}
    iniciarJefe: {fileID: 0}
    companera: 0
    logro: 
    flag: 
    musica: 
    conversacion: {fileID: 0}
    nodoConversacion: 
    darLlave: 
    nombreLlave: 
    marcarRecogidos: []
  finalHonesto:
  - Villa Dolores. 17:52.
  - "El port\xF3n azul de do\xF1a Rosario est\xE1 entreabierto. Adentro no hay luz.
    Solo el olor a api fr\xEDo y una radio encendida sin se\xF1al."
  - "Sobre la mesa, una nota escrita con l\xE1piz labial:\n\xABWara: me llevaron
    al coliseo de la Ceja. Dicen que ah\xED hay m\xE9dicos. Te espero. Mam\xE1.\xBB"
  - "Afuera, el helic\xF3ptero repite su anuncio hasta perderse detr\xE1s del Illimani."
  - "Tito cierra el port\xF3n y se sienta en el suelo, con la llave inglesa sobre
    las rodillas.\n\"El coliseo queda a doce cuadras. Con toque de queda... va a
    ser otra cosa, cebrita.\""
  - Son las 17:58.
  finalMentira:
  - Villa Dolores. 17:52.
  - "El port\xF3n azul de do\xF1a Rosario est\xE1 entreabierto. Adentro no hay luz.
    Solo el olor a api fr\xEDo y una radio encendida sin se\xF1al."
  - "Sobre la mesa, una nota escrita con l\xE1piz labial:\n\xABWara: me llevaron
    al coliseo de la Ceja. Dicen que ah\xED hay m\xE9dicos. Te espero. Mam\xE1.\xBB"
  - "Afuera, el helic\xF3ptero repite su anuncio hasta perderse detr\xE1s del Illimani."
  - "Tito cierra el port\xF3n y se sienta en el suelo, con la llave inglesa sobre
    las rodillas.\n\"El coliseo queda a doce cuadras. Con toque de queda... va a
    ser otra cosa, cebrita.\""
  - Son las 17:58.
