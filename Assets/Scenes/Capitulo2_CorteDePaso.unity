--- !u!114 &398630408
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 398630406}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f5cf9bfc590ca0847a46fd860b1c0829, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EleccionMoral
  prompt: Usar
  radio: 2.5
  altura: 0.8
  destello: 0
  nombreNPC: Chofer
  texto: "Un chofer de minib\xFAs est\xE1 sentado contra la llanta, con la mano apretada
    en el cuello. La sangre le corre entre los dedos.\n\n\"No... no tranquen la reja,
    por favor. Mi hermano Wilmer viene corriendo desde la Juan Pablo. Yo ya estoy
    mordido... pero \xE9l no. D\xE9jenla abierta.\"\n\nTito se rasca la nuca: \"Si
    la dejamos abierta, entra cualquier cosa, Wara.\""
  retrato: chofer
  opciones:
  - texto: '"Vamos a dejar la reja abierta. Que su hermano pueda entrar."'
    moral: 8
    costoVendas: 0
    darVendas: 0
    darBotellas: 0
    darPilas: 0
    dar: 
    respuesta: "\"Dios le pague, hijita... Wilmer tiene chompa verde. D\xEDganle
      que lo esper\xE9.\""
    acciones:
      objetivo: 
      usarMarcador: 0
      marcador: {x: 0, y: 0, z: 0}
      subtitulos:
      - Tito|Ta' bien... Pero si entra algo, entra por nosotros.
      mensaje: 
      activar: []
      desactivar: []
      alertar: []
      despertar: []
      puntoControl: 0
      sonido: 
      moral: 0
      progresoCielo: -1
      abrirPuerta: {fileID: 0}
      trabarPuertas: []
      destrabarPuertas: []
      iniciarAsedio: {fileID: 0}
      iniciarFinal: 0
      cinematica: {fileID: 0}
      iniciarJefe: {fileID: 0}
      companera: 0
      logro: 
      flag: reja_abierta
      musica: 
      conversacion: {fileID: 0}
      nodoConversacion: 
      darLlave: 
      nombreLlave: 
      marcarRecogidos: []
  - texto: '"Lo siento. Tenemos que trancar la reja."'
    moral: -6
    costoVendas: 0
    darVendas: 0
    darBotellas: 0
    darPilas: 0
    dar: 
    respuesta: '"No... por favor..." El chofer cierra los ojos. Tito pasa la cadena
      por los barrotes sin mirarlo.'
    acciones:
      objetivo: 
      usarMarcador: 0
      marcador: {x: 0, y: 0, z: 0}
      subtitulos: []
      mensaje: 
      activar: []
      desactivar: []
      alertar: []
      despertar: []
      puntoControl: 0
