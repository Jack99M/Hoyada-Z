  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Documento
  prompt: Usar
  radio: 1.8
  altura: 0.25
  destello: 1
  titulo: "Bit\xE1cora del guardia municipal"
  texto: "06:05  Corte de luz en toda la Ceja. El telef\xE9rico se para con gente
    adentro.\n06:40  Los t\xE9cnicos bajan a la gente de las cabinas con cuerdas.
    Dos cabinas quedan colgadas junto al and\xE9n.\n09:30  Llegan los de la UTOP.
    El subteniente Mamani cierra el patio de atr\xE1s de la estaci\xF3n.\n12:10 
    Mamani tiene fiebre, dice que no es nada. Grita solo.\n14:55  Se escuchan tiros
    en el patio. Cierro la caseta.\n15:30  Me mordieron en la mano. Dejo la tarjeta
    de mantenimiento en la mesa. Si alguien lee esto: la puerta del costado este."
  celular: 0
  guardarAlLeer: 0
  alLeer:
    objetivo: 
    usarMarcador: 0
