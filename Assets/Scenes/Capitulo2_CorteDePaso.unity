  m_EditorClassIdentifier: Assembly-CSharp::Documento
  prompt: Usar
  radio: 1.8
  altura: 0.25
  destello: 1
  titulo: "Radio de la UTOP (transcripci\xF3n)"
  texto: "CENTRAL: Unidades de la Ceja, reporte.\nMAMANI: Patio de la estaci\xF3n
    asegurado. Tengo fiebre, mi capit\xE1n, pero estoy firme.\nCENTRAL: Nadie cruza
    hacia Villa Dolores. Candado maestro en el port\xF3n.\nMAMANI: Los civiles no
    entienden, mi capit\xE1n. Los veo raros. Todos se ven raros.\nCENTRAL: A partir
    de las 18:00 est\xE1 autorizado el uso de fuerza letal. Repito: fuerza letal.\nMAMANI:
    ...Me arde la cabeza. Voy a quedarme en el patio. Nadie pasa. Nadie."
  celular: 0
  guardarAlLeer: 0
