--- !u!1001 &570781330
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 734193177}
    m_Modifications:
    - target: {fileID: 283836472821133027, guid: 206749f7304612f4b889074b5012bde1, type: 3}
      propertyPath: texto
      value: "Rami:\n\nSi lees esto, cerr\xE9 la cortina por fuera como dijo el jefe.
        La polic\xEDa dice que no dejemos salir a nadie hasta que llegue la ambulancia.\n\nLos
        que se pusieron mal estaban tosiendo toda la noche. Ten\xEDan los ojos negros,
        como si se les hubiera reventado todo por dentro.\n\nEl Diego se llev\xF3
        a los que pudo por la puerta de atr\xE1s. Tu llavero lo tienes t\xFA, as\xED
        que el dep\xF3sito queda cerrado.\n\nNo le abras a nadie.\n\n\u2014 Checo"
      objectReference: {fileID: 0}
    - target: {fileID: 283836472821133027, guid: 206749f7304612f4b889074b5012bde1, type: 3}
      propertyPath: titulo
      value: Nota para Rami
      objectReference: {fileID: 0}
