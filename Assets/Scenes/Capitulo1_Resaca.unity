--- !u!1001 &427212495
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 734193177}
    m_Modifications:
    - target: {fileID: 283836472821133027, guid: 206749f7304612f4b889074b5012bde1, type: 3}
      propertyPath: texto
      value: "<b>MAM\xC1 BETY (vecina)</b>  01:12\nMateo, hijito, \xBFd\xF3nde est\xE1s?
        Dicen en la radio que no salgamos. Hay gente enferma que ataca.\n\n<b>DIEGO</b> 
        01:47\nbro me voy, la gente se est\xE1 volviendo loca en la pista. uno mordi\xF3
        al guardia. SAL DE AH\xCD\n\n<b>DIEGO</b>  01:52\nte dej\xE9 dormido en el
        vip, perd\xF3n bro. no pod\xEDa cargarte\n\n<b>MAM\xC1 BETY</b>  03:30\nCerr\xE9
        el port\xF3n con cadena. Solo abro si eres t\xFA. Ven por las gradas de atr\xE1s
        del mercado, la avenida est\xE1 tomada.\n\n<b>MAM\xC1 BETY</b>  04:58\nMateo
        contesta por favor\n\n<color=#ff7766>Bater\xEDa: 3%</color>"
      objectReference: {fileID: 0}
    - target: {fileID: 283836472821133027, guid: 206749f7304612f4b889074b5012bde1, type: 3}
      propertyPath: titulo
      value: "Celular de Mateo \u2014 7 mensajes nuevos"
      objectReference: {fileID: 0}
    - target: {fileID: 283836472821133027, guid: 206749f7304612f4b889074b5012bde1, type: 3}
      propertyPath: guardarAlLeer
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 283836472821133027, guid: 206749f7304612f4b889074b5012bde1, type: 3}
