--- !u!114 &765224370
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 765224368}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f5cf9bfc590ca0847a46fd860b1c0829, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EleccionMoral
  prompt: Usar
  radio: 2.3
  altura: 0.8
  destello: 0
  nombreNPC: Don Freddy
  texto: "Un hombre mayor, sentado contra la pared de la farmacia. Tiene la pierna
    vendada con su chompa y la tela est\xE1 negra de sangre.\n\n\"Joven... \xBFno
    tendr\xE1s una venda? Esa cosa me mordi\xF3 en la pantorrilla.\""
  retrato: 
  opciones:
  - texto: Darle una de tus vendas
    moral: 10
    costoVendas: 1
    darVendas: 0
    darBotellas: 0
    darPilas: 1
    dar: 
    respuesta: 'Gracias, hijo. Dios te lo pague.

      Toma, la doctora me dio la
      llave del mercado antes de encerrarse. Yo ya no la voy a usar.

      No entres
      a la farmacia: ella ya no es ella.'
    acciones:
      objetivo: Entra al mercado por la puerta lateral (junto a la avenida)
      usarMarcador: 1
      marcador: {x: 8.5, y: 0, z: 62}
      subtitulos: []
      mensaje: 
      activar: []
      desactivar: []
      alertar: []
      despertar: []
      puntoControl: 0
      sonido: 
      moral: 0
      progresoCielo: -1
      abrirPuerta: {fileID: 0}
      trabarPuertas: []
      destrabarPuertas: []
      iniciarAsedio: {fileID: 0}
      iniciarFinal: 0
      cinematica: {fileID: 0}
      iniciarJefe: {fileID: 0}
      companera: 0
      logro: 
      flag: ayuda_freddy
      musica: 
      conversacion: {fileID: 0}
      nodoConversacion: 
      darLlave: llave_mercado
      nombreLlave: Llave del Mercado Sopocachi
      marcarRecogidos:
      - {fileID: 1254707254}
  - texto: '"Lo siento, no tengo nada para usted"'
    moral: -5
    costoVendas: 0
    darVendas: 0
    darBotellas: 0
    darPilas: 0
    dar: 
    respuesta: "Anda nom\xE1s... anda.\nSi vas al mercado, la llave la ten\xEDa la
      doctora, adentro de la farmacia."
    acciones:
      objetivo: 
      usarMarcador: 0
      marcador: {x: 0, y: 0, z: 0}
      subtitulos: []
      mensaje: 
      activar: []
      desactivar: []
      alertar: []
      despertar: []
      puntoControl: 0
      sonido: 
      moral: 0
      progresoCielo: -1
      abrirPuerta: {fileID: 0}
      trabarPuertas: []
      destrabarPuertas: []
      iniciarAsedio: {fileID: 0}
      iniciarFinal: 0
      cinematica: {fileID: 0}
      iniciarJefe: {fileID: 0}
      companera: 0
      logro: 
      flag: 
      musica: 
      conversacion: {fileID: 0}
      nodoConversacion: 
      darLlave: 
      nombreLlave: 
      marcarRecogidos: []
  - texto: Quitarle su mochila (tiene provisiones)
    moral: -15
    costoVendas: 0
    darVendas: 1
    darBotellas: 1
    darPilas: 0
    dar: alcohol:1
    respuesta: "\xA1Ladr\xF3n! \xA1As\xED nos vamos a morir todos, desgraciado!"
    acciones:
      objetivo: 
      usarMarcador: 0
      marcador: {x: 0, y: 0, z: 0}
      subtitulos: []
      mensaje: Los gritos de don Freddy atrajeron a los infectados
      activar: []
      desactivar: []
      alertar:
      - {fileID: 1836838550}
      - {fileID: 1809856512}
      despertar: []
      puntoControl: 0
      sonido: sfx_grito
