  m_Script: {fileID: 11500000, guid: 505f4cad91858c34f903344b227a8b9f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Documento
  prompt: Usar
  radio: 1.8
  altura: 0.25
  destello: 1
  titulo: "El Chasqui Pace\xF1o"
  texto: "EL CHASQUI PACE\xD1O \u2014 Viernes\n\n<b>FIEBRE DEL CHOQUEYAPU: AUTORIDADES
    DESCARTAN EPIDEMIA</b>\n\nLuego de que se reportaran 23 casos de un cuadro febril
    con conducta agresiva en barrios ribere\xF1os, el SEDES asegur\xF3 que \"no hay
    motivo de alarma\" y que se tratar\xEDa de una intoxicaci\xF3n por aguas servidas.\n\nVecinos
    de Obrajes denuncian que desde hace semanas el r\xEDo \"huele a hongo\" y que
    aparecieron costras amarillas en las piedras.\n\nEn la p\xE1gina 4: Alasitas,
    la feria de los deseos, abrir\xE1 igual en enero. \"El Ekeko no se suspende\",
    dicen los artesanos."
  celular: 0
  guardarAlLeer: 0
  alLeer:
    objetivo: 
    usarMarcador: 0
    marcador: {x: 0, y: 0, z: 0}
