  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 505f4cad91858c34f903344b227a8b9f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Documento
  prompt: Usar
  radio: 1.8
  altura: 0.25
  destello: 1
  titulo: Recetario de Mama Bety
  texto: "Hoja de cuaderno, letra redonda y cuidadosa:\n\n<i>Para Rosita, para la
    fiebre de tu Efra\xEDn:</i>\n\nMu\xF1a, wira wira y eucalipto, hervido en agua
    de vertiente, NO del grifo.\nFrotarle el pecho con grasa de llama y cubrirlo
    con aguayo.\nSi tiene los ojos negros y hace ruido con la garganta, ya no es
    tu Efra\xEDn. Enci\xE9rralo y reza.\n\nMi abuelo, que era kallawaya, dec\xEDa
    que hay males que bajan del r\xEDo. Que solo se detienen en la altura, donde
    el fr\xEDo no los deja crecer.\n\n\u2014 Beatriz Mamani"
  celular: 0
  guardarAlLeer: 0
  alLeer:
    objetivo: 
    usarMarcador: 0
