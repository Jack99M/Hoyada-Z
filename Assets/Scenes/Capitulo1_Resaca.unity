--- !u!1001 &1065630019
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 146389840}
    m_Modifications:
    - target: {fileID: 283836472821133027, guid: 206749f7304612f4b889074b5012bde1, type: 3}
      propertyPath: texto
      value: "Cuaderno de ventas \u2014 Rosa Quispe, puesto 23\n\nLunes: 40 Bs de
        papa, 25 de chu\xF1o. Poca gente.\nMartes: la pila del mercado sale con olor
        raro. Don Efra\xEDn dice que es el r\xEDo.\nMi\xE9rcoles: la vecina del 12
        no vino. Dicen que tiene fiebre.\nJueves: vinieron camionetas del hospital.
        Se llevaron a tres caseras.\nViernes: cerramos temprano. Don Efra\xEDn ya
        no es \xE9l. Tiene como costras amarillas en la cara y hace un ruido con
        la garganta, clic, clic, como si llamara a alguien. No ve nada, pero te encuentra
        igual. Si haces ruido, te encuentra.\n\nSi me encuentras, no me abras."
      objectReference: {fileID: 0}
    - target: {fileID: 283836472821133027, guid: 206749f7304612f4b889074b5012bde1, type: 3}
      propertyPath: titulo
      value: "Cuaderno de do\xF1a Rosa"
      objectReference: {fileID: 0}
    - target: {fileID: 283836472821133027, guid: 206749f7304612f4b889074b5012bde1, type: 3}
      propertyPath: celular
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3344614350178548996, guid: 206749f7304612f4b889074b5012bde1, type: 3}
      propertyPath: m_LocalPosition.x
      value: 26.8
      objectReference: {fileID: 0}
