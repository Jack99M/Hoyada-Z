    m_Modifications:
    - target: {fileID: 283836472821133027, guid: 206749f7304612f4b889074b5012bde1, type: 3}
      propertyPath: texto
      value: "Hoja de cuaderno pegada con cinta a un poste, cerca de las gradas:\n\n<b>WARA:</b>\nHijita,
        nos vamos a la casa de tu t\xEDa Juana en la Ceja, la del port\xF3n verde,
        detr\xE1s de la Plaza de la Cruz.\nEl telef\xE9rico no funciona. Vamos a
        pie, siguiendo los cables de la L\xEDnea Amarilla.\nNo tomes agua del grifo.
        Te esperamos.\n\n\u2014 Mam\xE1 (Rosario)"
      objectReference: {fileID: 0}
    - target: {fileID: 283836472821133027, guid: 206749f7304612f4b889074b5012bde1, type: 3}
      propertyPath: titulo
