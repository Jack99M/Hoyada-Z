  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Documento
  prompt: Usar
  radio: 1.8
  altura: 0.25
  destello: 1
  titulo: Nota para Rami
  texto: "Rami:\n\nSi lees esto, cerr\xE9 la cortina por fuera como dijo el jefe.
    La polic\xEDa dice que no dejemos salir a nadie hasta que llegue la ambulancia.\n\nLos
    que se pusieron mal estaban tosiendo toda la noche. Ten\xEDan los ojos negros,
    como si se les hubiera reventado todo por dentro.\n\nEl Diego se llev\xF3 a los
    que pudo por la puerta de atr\xE1s. Tu llavero lo tienes t\xFA, as\xED que el
    dep\xF3sito queda cerrado.\n\nNo le abras a nadie.\n\n\u2014 Checo"
  celular: 0
  guardarAlLeer: 0
