--- !u!1001 &1527193578
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1222982574}
    m_Modifications:
    - target: {fileID: 283836472821133027, guid: 206749f7304612f4b889074b5012bde1, type: 3}
      propertyPath: texto
      value: "Para quien lea esto:\n\nAtend\xED a once personas esta noche. Todas
        con lo mismo: fiebre, temblores, las venas negras.\nTodas hab\xEDan tomado
        agua de la pila del mercado.\n\nNo es rabia. No es gripe. Los antibi\xF3ticos
        no hacen nada.\nUn paciente muri\xF3 a las 2:10. A las 2:25 se levant\xF3.\n\nMe
        mordi\xF3 en la mano. Ya siento la fiebre.\n\nDej\xE9 la llave del mercado
        en el dep\xF3sito, al fondo. Adentro hay agua embotellada: que la saquen
        para los vecinos.\n\nQue Dios nos perdone.\n\u2014 Dra. Julia Mamani"
      objectReference: {fileID: 0}
    - target: {fileID: 283836472821133027, guid: 206749f7304612f4b889074b5012bde1, type: 3}
      propertyPath: titulo
      value: Nota de la Dra. Julia
      objectReference: {fileID: 0}
