  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EleccionMoral
  prompt: Usar
  radio: 2.3
  altura: 0.8
  destello: 0
  nombreNPC: Don Freddy
  texto: "Un hombre mayor, sentado contra la pared de la farmacia. Tiene la pierna
    vendada con su chompa y la tela est\xE1 negra de sangre.\n\n\"Joven... \xBFno
    tendr\xE1s una venda? Esa cosa me mordi\xF3 en la pantorrilla.\""
  retrato: 
  opciones:
  - texto: Darle una de tus vendas
    moral: 10
    costoVendas: 1
    darVendas: 0
    darBotellas: 0
    darPilas: 1
    dar: 
    respuesta: "Gracias, hijo. Dios te lo pague.\nToma estas pilas, de algo te servir\xE1n.\nLa
      doctora de la farmacia ten\xEDa la llave del mercado... pero ya no es ella.
      Ten cuidado."
    acciones:
      objetivo: 
      usarMarcador: 0
      marcador: {x: 0, y: 0, z: 0}
      subtitulos: []
      mensaje: 
      activar: []
      desactivar: []
      alertar: []
      despertar: []
      puntoControl: 0
      sonido: 
      moral: 0
      progresoCielo: -1
      abrirPuerta: {fileID: 0}
      trabarPuertas: []
      destrabarPuertas: []
      iniciarAsedio: {fileID: 0}
      iniciarFinal: 0
      cinematica: {fileID: 0}
      iniciarJefe: {fileID: 0}
      companera: 0
      logro: 
      flag: ayuda_freddy
      musica: 
      conversacion: {fileID: 0}
      nodoConversacion: 
  - texto: '"Lo siento, no tengo nada para usted"'
    moral: -5
    costoVendas: 0
    darVendas: 0
    darBotellas: 0
    darPilas: 0
    dar: 
    respuesta: "Anda nom\xE1s... anda.\nSi vas al mercado, la llave la ten\xEDa la
      doctora, adentro de la farmacia."
    acciones:
      objetivo: 
      usarMarcador: 0
      marcador: {x: 0, y: 0, z: 0}
      subtitulos: []
      mensaje: 
      activar: []
