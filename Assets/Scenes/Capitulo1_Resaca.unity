  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Documento
  prompt: Usar
  radio: 1.8
  altura: 0.25
  destello: 1
  titulo: Nota pegada en un poste
  texto: "Hoja de cuaderno pegada con cinta a un poste, cerca de las gradas:\n\n<b>WARA:</b>\nHijita,
    nos vamos a la casa de tu t\xEDa Juana en la Ceja, la del port\xF3n verde, detr\xE1s
    de la Plaza de la Cruz.\nEl telef\xE9rico no funciona. Vamos a pie, siguiendo
    los cables de la L\xEDnea Amarilla.\nNo tomes agua del grifo. Te esperamos.\n\n\u2014
    Mam\xE1 (Rosario)"
  celular: 0
  guardarAlLeer: 0
  alLeer:
    objetivo: 
    usarMarcador: 0
    marcador: {x: 0, y: 0, z: 0}
    subtitulos:
    - "Mateo|Rosario... la mam\xE1 de Wara. Ojal\xE1 la encuentre."
