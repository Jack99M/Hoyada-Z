--- !u!114 &313582842
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 313582840}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 505f4cad91858c34f903344b227a8b9f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Documento
  prompt: Usar
  radio: 1.8
  altura: 0.25
  destello: 1
  titulo: "Celular de Mateo \u2014 7 mensajes nuevos"
  texto: "<b>MAM\xC1 BETY (vecina)</b>  01:12\nMateo, hijito, \xBFd\xF3nde est\xE1s?
    Dicen en la radio que no salgamos. Hay gente enferma que ataca.\n\n<b>DIEGO</b> 
    01:47\nbro me voy, la gente se est\xE1 volviendo loca en la pista. uno mordi\xF3
    al guardia. SAL DE AH\xCD\n\n<b>DIEGO</b>  01:52\nte dej\xE9 dormido en el vip,
    perd\xF3n bro. no pod\xEDa cargarte\n\n<b>MAM\xC1 BETY</b>  03:30\nCerr\xE9 el
    port\xF3n con cadena. Solo abro si eres t\xFA. Ven por las gradas de atr\xE1s
    del mercado, la avenida est\xE1 tomada.\n\n<b>MAM\xC1 BETY</b>  04:58\nMateo
    contesta por favor\n\n<color=#ff7766>Bater\xEDa: 3%</color>"
  celular: 1
  guardarAlLeer: 1
  alLeer:
    objetivo: Sal de la discoteca
    usarMarcador: 1
    marcador: {x: -26, y: 0, z: 0}
    subtitulos:
    - Mateo|...Esto tiene que ser una broma.
    - "Mateo|Tengo que llegar donde do\xF1a Bety."
