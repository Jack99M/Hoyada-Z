        iniciarJefe: {fileID: 0}
        companera: 2
        logro: 
        flag: 
        musica: 
        conversacion: {fileID: 0}
        nodoConversacion: 
        darLlave: 
        nombreLlave: 
        marcarRecogidos: []
  - id: despedida_no
    quien: Wara
    retrato: wara
    texto: "\"No puedo. Es mi mam\xE1.\"\n\nWara te abraza fuerte y r\xE1pido, como
      quien se despide en la terminal de buses. Despu\xE9s sube corriendo, silbando
      como silban las cebras en el cruce."
    opciones:
    - texto: "\"Cu\xEDdate, cebra.\""
      siguiente: 
      costo: 
      dar: 
      moral: 2
      requiereFlag: 
      requiereSinFlag: 
      ponerFlag: 
