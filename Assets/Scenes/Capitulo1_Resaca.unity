--- !u!1001 &734150816
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1881382371}
    m_Modifications:
    - target: {fileID: 283836472821133027, guid: 206749f7304612f4b889074b5012bde1, type: 3}
      propertyPath: texto
      value: "Papel manchado, pegado a la puerta de la c\xE1mara frigor\xEDfica:\n\n\"Me
        mordi\xF3 el perro del mercado el martes. Desde ah\xED tengo hambre todo
        el tiempo. Hambre de carne cruda.\n\nAnoche casi muerdo a mi hija.\n\nMe
        voy a encerrar en la c\xE1mara. Hace fr\xEDo adentro, dicen que el fr\xEDo
        la frena.\n\nSI ESCUCHAN GOLPES, NO ABRAN. POR NADA DEL MUNDO.\n\n\u2014
        Cirilo, puesto 7\""
      objectReference: {fileID: 0}
    - target: {fileID: 283836472821133027, guid: 206749f7304612f4b889074b5012bde1, type: 3}
      propertyPath: titulo
