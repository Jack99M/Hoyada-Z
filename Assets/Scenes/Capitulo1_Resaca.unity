  nodos:
  - id: inicio
    quien: El Chino
    retrato: lustra
    texto: "Un lustrabotas con pasamonta\xF1as est\xE1 sentado en un zagu\xE1n, con
      su caj\xF3n entre las piernas. Tiene un fierro en la mano y no parece asustado.\n\n\"Tranquilo,
      joven. Aqu\xED nadie muerde... todav\xEDa. Me dicen el Chino. \xBFHacemos trueque?
      La plata ya no vale nada.\""
    opciones:
    - texto: 'Trueque: 2 botellas por trapo y alcohol'
      siguiente: inicio
      costo: botellas:2
      dar: trapo:1,alcohol:1
      moral: 0
      requiereFlag: 
      requiereSinFlag: 
      ponerFlag: 
      unaVez: 1
      respuesta: 
