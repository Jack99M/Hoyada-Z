  m_Script: {fileID: 11500000, guid: 505f4cad91858c34f903344b227a8b9f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Documento
  prompt: Usar
  radio: 1.8
  altura: 0.25
  destello: 1
  titulo: "Cuaderno de do\xF1a Rosa"
  texto: "Cuaderno de ventas \u2014 Rosa Quispe, puesto 23\n\nLunes: 40 Bs de papa,
    25 de chu\xF1o. Poca gente.\nMartes: la pila del mercado sale con olor raro.
    Don Efra\xEDn dice que es el r\xEDo.\nMi\xE9rcoles: la vecina del 12 no vino.
    Dicen que tiene fiebre.\nJueves: vinieron camionetas del hospital. Se llevaron
    a tres caseras.\nViernes: cerramos temprano. Don Efra\xEDn ya no es \xE9l. Tiene
    como costras amarillas en la cara y hace un ruido con la garganta, clic, clic,
    como si llamara a alguien. No ve nada, pero te encuentra igual. Si haces ruido,
    te encuentra.\n\nSi me encuentras, no me abras."
  celular: 0
  guardarAlLeer: 0
